<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- BOTÓN ATRÁS -->
        <Button
            android:id="@+id/btnAtras"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="Atrás"
            android:backgroundTint="#6B4DB5" />

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GESTIÓN DE INGREDIENTES"
            android:textAlignment="center"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp" />

        <!-- DATOS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Datos del ingrediente"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/txtIngID"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="ID"
            android:inputType="number" />

        <EditText
            android:id="@+id/txtIngName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Nombre ingrediente" />

        <EditText
            android:id="@+id/txtIngCalories"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Calorías"
            android:inputType="numberDecimal" />

        <Switch
            android:id="@+id/swIngEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activo"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="15dp" />

        <!-- BOTONES CRUD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCrearIng"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Crear"
                android:backgroundTint="#6B4DB5"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnLeerIng"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Leer"
                android:backgroundTint="#6B4DB5"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnActualizarIng"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Actualizar"
                android:backgroundTint="#6B4DB5"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnEliminarIng"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Eliminar"
                android:backgroundTint="#6B4DB5"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- RESULTADO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultado"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#F5F5F5">

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/txtResultadoIng"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:text="Aquí se mostrará el resultado REST..."
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:typeface="monospace" />

            </ScrollView>

        </HorizontalScrollView>

    </LinearLayout>

</ScrollView>